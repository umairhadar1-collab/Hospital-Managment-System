<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> - Hospital Front Desk</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
<% if (user) { %>
<header class="topbar no-print">
  <div class="brand">Hospital Front Desk</div>
  <nav>
    <a href="/patients/new">New Patient</a>
    <a href="/patients">Recent Patients</a>
    <a href="/lab/new">Lab Order</a>
    <a href="/lab">Lab Orders</a>
    <a href="/lab/tests">Lab Tests</a>
    <% if (user.role === 'admin') { %><a href="/admin/audit">Audit Log</a><% } %>
  </nav>
  <form method="post" action="/logout" class="logout">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <span><%= user.fullName %> (<%= user.role %>)</span>
    <button type="submit" class="btn btn-small">Logout</button>
  </form>
</header>
<% } %>
<main class="container">
